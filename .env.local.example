# sizzle — local secrets. NEVER commit this file. .gitignore already excludes it.
# Paste each value after the =

# 1. GitHub token — classic, NO scopes ticked.
#    Scopeless still lifts public-data rate limit from 60/hr to 5000/hr.
#    Create at: https://github.com/settings/tokens  ->  Generate new token (classic)
GITHUB_TOKEN=

# 2. Google Gemini API key (you have ~$7 credit on this).
#    Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 3. OpenRouter — primary LLM, free-tier models.
#    You already have this set as a system env var; paste it here too so the
#    Next.js app picks it up without depending on your shell environment.
#    Find/create at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
